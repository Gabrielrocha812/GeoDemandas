# ==========================================================================
# GeoDemandas Brandt - Variáveis de Ambiente
# Copie este arquivo para ".env" e ajuste os valores para o seu ambiente.
# Em desenvolvimento você pode deixar DEV_MODE=true para simular LDAP/IMAP
# sem precisar de servidores reais (dados fictícios embutidos no código).
# ==========================================================================

# --- Geral ---------------------------------------------------------------
APP_NAME="GeoDemandas Brandt"
APP_BASE_URL="http://localhost:8000"
APP_TIMEZONE="America/Sao_Paulo"
SECRET_KEY="troque-esta-chave-por-uma-aleatoria-bem-grande"
DEV_MODE=true                 # true = mantém o worker de e-mail em modo simulado
LDAP_USE_REAL=false           # true = autentica usuários no Active Directory real
INITIAL_ADMIN_EMAILS=""       # e-mails separados por vírgula para criar o primeiro admin

# --- Banco de Dados ------------------------------------------------------
# SQLite (padrão, zero configuração):
DATABASE_URL="sqlite:///./geodemandas.db"
# PostgreSQL (exemplo):
# DATABASE_URL="postgresql+psycopg2://usuario:senha@localhost:5432/geodemandas"

# --- SLA operacional (horas corridas) ------------------------------------
SLA_BUSINESS_START_HOUR=8
SLA_BUSINESS_END_HOUR=18
SLA_HOLIDAYS=
SLA_FIRST_RESPONSE_HOURS_BAIXA=24
SLA_FIRST_RESPONSE_HOURS_MEDIA=8
SLA_FIRST_RESPONSE_HOURS_ALTA=4
SLA_FIRST_RESPONSE_HOURS_URGENTE=1
SLA_RESOLUTION_HOURS_BAIXA=120
SLA_RESOLUTION_HOURS_MEDIA=72
SLA_RESOLUTION_HOURS_ALTA=24
SLA_RESOLUTION_HOURS_URGENTE=8
SLA_RISK_WINDOW_HOURS=4
SLA_ALERT_POLL_INTERVAL_SECONDS=300
LOGIN_RATE_LIMIT_ATTEMPTS=5
LOGIN_RATE_LIMIT_WINDOW_SECONDS=900
WORKER_HEARTBEAT_MAX_AGE_SECONDS=900
EMBEDDED_WORKERS=true
ALLOWED_HOSTS="localhost,127.0.0.1"
FORCE_HTTPS=false
KANBAN_COLUMN_LIMIT=50
DASHBOARD_PAGE_SIZE=25

# --- Caixa de e-mail monitorada (IMAP) -----------------------------------
IMAP_HOST="imap.brandt.com.br"
IMAP_PORT=993
IMAP_USE_SSL=true
IMAP_USER="geodemandas@brandt.com.br"
IMAP_PASSWORD="senha-da-caixa-geodemandas"
IMAP_MAILBOX="INBOX"
EMAIL_PROVIDER="smtp"
SMTP_ENABLED=false
SMTP_HOST=""
SMTP_PORT=587
SMTP_USE_TLS=true
SMTP_USERNAME=""
SMTP_PASSWORD=""
SMTP_FROM_EMAIL="geodemandas@brandt.com.br"
SMTP_FROM_NAME="GeoDemandas Brandt"
# Outbox: envio duravel, em lote e com retentativa exponencial.
NOTIFICATION_OUTBOX_POLL_INTERVAL=5
NOTIFICATION_OUTBOX_BATCH_SIZE=20
NOTIFICATION_OUTBOX_MAX_ATTEMPTS=5
NOTIFICATION_OUTBOX_RETRY_BASE_SECONDS=30
NOTIFICATION_OUTBOX_RETRY_MAX_SECONDS=3600
NOTIFICATION_OUTBOX_LOCK_TIMEOUT_SECONDS=300
GRAPH_TENANT_ID=""
GRAPH_CLIENT_ID=""
GRAPH_CLIENT_SECRET=""
GRAPH_SENDER_EMAIL="geodemandas@brandt.com.br"
UPLOAD_DIR="uploads"
MAX_ATTACHMENT_SIZE_MB=25
MAX_ATTACHMENTS_PER_MESSAGE=10
BLOCKED_ATTACHMENT_EXTENSIONS=.exe,.com,.bat,.cmd,.ps1,.js,.vbs,.scr,.msi,.dll
REQUIRE_ANTIVIRUS=false
ANTIVIRUS_COMMAND=clamdscan
ANTIVIRUS_TIMEOUT_SECONDS=30
EMAIL_POLL_INTERVAL=30        # segundos entre cada checagem da caixa

# --- API corporativa de projetos -----------------------------------------
# Alimenta o seletor de projeto no cadastro de demandas (header x-token).
PROJETOS_API_URL="http://69.64.32.23:8000/projetos"
PROJETOS_API_TOKEN=""
PROJETOS_API_TIMEOUT=10        # segundos de espera pela API
PROJETOS_CACHE_TTL=300         # segundos de cache da lista em memoria

# --- Active Directory (LDAP) ---------------------------------------------
LDAP_SERVER="BMABH16.brandt.local"
LDAP_PORT=389
LDAP_USE_SSL=false            # true para ldaps:// na porta 636
LDAP_BASE_DN="DC=brandt,DC=local"
# Usuário de serviço usado para consultar o AD (bind técnico)
LDAP_BIND_DN="CN=svc_geodemandas,OU=Servicos,DC=brandt,DC=com,DC=br"
LDAP_BIND_PASSWORD="senha-do-usuario-de-servico"
# Sufixo de domínio usado para login estilo user@dominio (UPN)
LDAP_DOMAIN="brandt.com.br"

[Unit]
Description=GeoDemandas Background Workers
After=network-online.target postgresql.service

[Service]
Type=simple
User=geodemandas
WorkingDirectory=/opt/geodemandas/current
EnvironmentFile=/etc/geodemandas/geodemandas.env
ExecStart=/opt/geodemandas/venv/bin/python worker_main.py
Restart=always
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/geodemandas/uploads

[Install]
WantedBy=multi-user.target

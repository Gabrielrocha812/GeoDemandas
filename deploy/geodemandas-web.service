[Unit]
Description=GeoDemandas Web
After=network-online.target

[Service]
Type=simple
User=geodemandas
WorkingDirectory=/opt/geodemandas
EnvironmentFile=/opt/geodemandas/.env
Environment=EMBEDDED_WORKERS=false
ExecStart=/opt/geodemandas/.venv/bin/uvicorn main:app --host 0.0.0.0 --port 8046 --workers 2
Restart=always
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
